# Copy this file to .dev.vars and replace the placeholders locally.
# Never commit .dev.vars.
BLURAY_COLLECTION_URL="https://www.blu-ray.com/community/collection.php?u=your-user-id&sortby=recentlyaddedcollection"
TMDB_READ_ACCESS_TOKEN="replace-with-your-tmdb-read-access-token"
SYNC_ADMIN_TOKEN="replace-with-a-long-random-token"
SYNC_IMPORT_URL="http://localhost:5173/api/internal/collection-snapshot"
ACCESS_TEAM_DOMAIN="https://your-team-name.cloudflareaccess.com"
ACCESS_AUD="replace-with-your-access-application-audience"
# Required by the importer only when SYNC_IMPORT_URL is not local HTTP.
CF_ACCESS_CLIENT_ID="replace-with-your-access-service-token-client-id"
CF_ACCESS_CLIENT_SECRET="replace-with-your-access-service-token-client-secret"
